/* pages/detail/detail.wxss */

page {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe0e6 50%, #ffd1dc 100%);
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

/* ── 页面标题区域 ── */
.page-header {
  text-align: center;
  padding: 60rpx 30rpx;
  margin-bottom: 30rpx;
  position: relative;
}

.page-header::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 107, 129, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  z-index: 0;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #e85365 0%, #ff6b81 50%, #ff8fa3 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  display: block;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 20rpx rgba(232, 83, 101, 0.2);
}

.page-subtitle {
  font-size: 26rpx;
  color: #c97b88;
  display: block;
  position: relative;
  z-index: 1;
  font-weight: 500;
}

.page-subtitle::before,
.page-subtitle::after {
  content: '✦';
  margin: 0 16rpx;
  color: #ff8fa3;
  font-size: 20rpx;
}

/* ── 瀑布流容器 ── */
.waterfall-container {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ── 媒体项 ── */
.media-item {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #ffffff 0%, #fff8f9 100%);
  box-shadow:
    0 8rpx 32rpx rgba(232, 83, 101, 0.12),
    0 2rpx 8rpx rgba(232, 83, 101, 0.06);
  /* 丝滑平顺的尺寸过渡动画 */
  transition:
    transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
    box-shadow 0.3s ease,
    opacity 0.4s ease;
  transform: translateY(0);
  will-change: transform, height;
}

/* 初始未知状态 - 使用默认过渡尺寸 */
.media-item.unknown {
  aspect-ratio: 1;
  animation: gentle-pulse 2s ease-in-out infinite;
}

@keyframes gentle-pulse {
  0%, 100% {
    opacity: 0.8;
  }
  50% {
    opacity: 1;
  }
}

.media-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    180deg,
    transparent 60%,
    rgba(232, 83, 101, 0.03) 100%
  );
  z-index: 1;
  pointer-events: none;
}

.media-item:active {
  transform: scale(0.96) translateY(4rpx);
  box-shadow: 
    0 4rpx 16rpx rgba(232, 83, 101, 0.15),
    0 1rpx 4rpx rgba(232, 83, 101, 0.08);
}

/* 竖图样式 - 高窄 */
.media-item.portrait {
  aspect-ratio: 3/4;
  animation: slide-in-up 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* 横图样式 - 矮宽 */
.media-item.landscape {
  aspect-ratio: 4/3;
  animation: slide-in-up 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* 图片项滑入动画 - 丝滑平顺 */
@keyframes slide-in-up {
  0% {
    opacity: 0.7;
    transform: translateY(20rpx) scale(0.98);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 瀑布流列容器 - 确保平滑布局变化 */
.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ── 媒体预览 ── */
.media-preview {
  position: relative;
  width: 100%;
  height: 100%;
}

.media-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

/* ── 视频播放按钮 ── */
.video-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, rgba(232, 83, 101, 0.9) 0%, rgba(255, 107, 129, 0.9) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 8rpx 32rpx rgba(232, 83, 101, 0.4),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.3);
  z-index: 2;
  transition: all 0.3s ease;
}

.video-play-btn::before {
  content: '';
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border: 2rpx solid rgba(232, 83, 101, 0.3);
  border-radius: 50%;
  animation: pulse-ring 2s ease-out infinite;
}

@keyframes pulse-ring {
  0% {
    transform: scale(0.8);
    opacity: 1;
  }
  100% {
    transform: scale(1.3);
    opacity: 0;
  }
}

.play-icon {
  width: 0;
  height: 0;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
  border-left: 28rpx solid #fff;
  margin-left: 6rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2));
}

/* ── Loading 遮罩层 ── */
.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(145deg, #fff8f9 0%, #ffeef1 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* ── 心跳 Loading 动画 ── */
.heart-loader {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.heart {
  width: 30rpx;
  height: 30rpx;
  background: linear-gradient(135deg, #e85365 0%, #ff8fa3 100%);
  position: relative;
  transform: rotate(-45deg);
  animation: heartbeat 1.2s ease-in-out infinite;
  box-shadow: 0 4rpx 16rpx rgba(232, 83, 101, 0.3);
}

.heart::before,
.heart::after {
  content: '';
  width: 30rpx;
  height: 30rpx;
  position: absolute;
  background: linear-gradient(135deg, #e85365 0%, #ff8fa3 100%);
  border-radius: 50%;
}

.heart::before {
  top: -15rpx;
  left: 0;
}

.heart::after {
  top: 0;
  left: 15rpx;
}

.heart-ring {
  position: absolute;
  border: 2rpx solid rgba(232, 83, 101, 0.3);
  border-radius: 50%;
  opacity: 0;
}

.ring-1 {
  width: 80rpx;
  height: 80rpx;
  animation: pulse-ring-1 1.2s ease-out infinite;
}

.ring-2 {
  width: 100rpx;
  height: 100rpx;
  animation: pulse-ring-2 1.2s ease-out infinite 0.4s;
}

@keyframes heartbeat {
  0%, 100% {
    transform: rotate(-45deg) scale(1);
  }
  14% {
    transform: rotate(-45deg) scale(1.1);
  }
  28% {
    transform: rotate(-45deg) scale(1);
  }
  42% {
    transform: rotate(-45deg) scale(1.1);
  }
  70% {
    transform: rotate(-45deg) scale(1);
  }
}

@keyframes pulse-ring-1 {
  0% {
    transform: scale(0.6);
    opacity: 0.6;
  }
  100% {
    transform: scale(1.2);
    opacity: 0;
  }
}

@keyframes pulse-ring-2 {
  0% {
    transform: scale(0.5);
    opacity: 0.4;
  }
  100% {
    transform: scale(1.3);
    opacity: 0;
  }
}

/* ── 图片加载完成动画 ── */
.media-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  opacity: 0;
  transition: opacity 0.5s ease;
}

.media-img.loaded {
  opacity: 1;
}

/* ── 装饰元素 ── */
.decor-circle {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.decor-circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255, 143, 163, 0.1) 0%, transparent 70%);
  top: -100rpx;
  right: -100rpx;
}

.decor-circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(232, 83, 101, 0.08) 0%, transparent 70%);
  bottom: 200rpx;
  left: -80rpx;
}

/* ── 响应式适配 ── */
@media (max-width: 750rpx) {
  .container {
    padding: 20rpx;
  }
  
  .page-header {
    padding: 40rpx 20rpx;
  }
  
  .page-title {
    font-size: 40rpx;
  }
  
  .waterfall-container {
    gap: 16rpx;
  }
  
  .waterfall-column {
    gap: 16rpx;
  }
  
  .media-item {
    border-radius: 20rpx;
  }
  
  .video-play-btn {
    width: 72rpx;
    height: 72rpx;
  }
  
  .play-icon {
    border-top: 14rpx solid transparent;
    border-bottom: 14rpx solid transparent;
    border-left: 22rpx solid #fff;
  }
}

@media (max-width: 480rpx) {
  .waterfall-container {
    flex-direction: column;
    gap: 16rpx;
  }
  
  .waterfall-column {
    gap: 16rpx;
  }
}

/* ── 空状态 ── */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #c97b88;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #c97b88;
}
