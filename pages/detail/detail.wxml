<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">{{module.name}}</text>
    <text class="page-subtitle">{{module.media.length}} 个媒体文件</text>
  </view>

  <!-- 瀑布流媒体列表 -->
  <view class="waterfall-container">
    <view class="waterfall-column" wx:for="{{columns}}" wx:key="columnIndex" wx:for-index="columnIndex">
      <view
        wx:for="{{item}}"
        wx:key="itemIndex"
        wx:for-index="itemIndex"
        class="media-item"
        bindtap="previewMedia"
        data-index="{{item}}"
      >
        <!-- 图片或视频预览 -->
        <view class="media-preview">
          <image
            class="media-img"
            src="{{media[item].thumbnail}}"
            mode="aspectFill"
            lazy-load="true"
          />
          <!-- 视频播放按钮 -->
          <view wx:if="{{media[item].isVideo}}" class="video-play-btn">
            <view class="play-icon"></view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>