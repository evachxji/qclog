/* ── 页面基础 ── */
page {
  background: linear-gradient(180deg, #fff8f8 0%, #ffe8ec 50%, #ffd4dd 100%);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
}

/* ── 装饰背景圆 ── */
.decor-circle {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.decor-circle-1 {
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(255, 143, 163, 0.15) 0%, transparent 70%);
  top: -150rpx;
  right: -150rpx;
}

.decor-circle-2 {
  width: 350rpx;
  height: 350rpx;
  background: radial-gradient(circle, rgba(232, 83, 101, 0.1) 0%, transparent 70%);
  bottom: 200rpx;
  left: -100rpx;
}

.decor-circle-3 {
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 182, 193, 0.2) 0%, transparent 70%);
  top: 40%;
  right: -50rpx;
}

/* ── 主内容区 ── */
.content-wrapper {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 600rpx;
}

/* ── 图标动画区 ── */
.icon-container {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gear {
  position: absolute;
  color: #e85365;
  text-shadow: 0 4rpx 20rpx rgba(232, 83, 101, 0.3);
}

.gear-large {
  font-size: 120rpx;
  animation: rotate-slow 8s linear infinite;
  opacity: 0.9;
}

.gear-small {
  font-size: 70rpx;
  right: 20rpx;
  top: 20rpx;
  animation: rotate-reverse 6s linear infinite;
  opacity: 0.7;
}

@keyframes rotate-slow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes rotate-reverse {
  from { transform: rotate(360deg); }
  to { transform: rotate(0deg); }
}

/* 闪烁星星 */
.sparkle {
  position: absolute;
  color: #ff8fa3;
  font-size: 24rpx;
  animation: twinkle 2s ease-in-out infinite;
}

.sparkle-1 {
  top: 10rpx;
  left: 20rpx;
  animation-delay: 0s;
}

.sparkle-2 {
  bottom: 30rpx;
  left: 10rpx;
  animation-delay: 0.6s;
}

.sparkle-3 {
  top: 40rpx;
  right: 10rpx;
  animation-delay: 1.2s;
}

@keyframes twinkle {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* ── 标题区 ── */
.title-box {
  text-align: center;
  margin-bottom: 40rpx;
}

.main-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #e85365 0%, #ff6b81 50%, #ff8fa3 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 20rpx rgba(232, 83, 101, 0.15);
  margin-bottom: 16rpx;
}

.title-line {
  width: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent 0%, #e85365 50%, transparent 100%);
  margin: 0 auto;
  border-radius: 2rpx;
}

/* ── 描述卡片 ── */
.desc-card {
  background: linear-gradient(145deg, #ffffff 0%, #fff8f9 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  width: 100%;
  text-align: center;
  box-shadow:
    0 12rpx 40rpx rgba(232, 83, 101, 0.12),
    0 4rpx 12rpx rgba(232, 83, 101, 0.06);
  border: 1rpx solid rgba(255, 143, 163, 0.15);
  position: relative;
  overflow: hidden;
  margin-bottom: 40rpx;
}

.card-accent {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #e85365 0%, #ff8fa3 100%);
}

.desc-text {
  display: block;
  font-size: 30rpx;
  color: #e85365;
  font-weight: 600;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.sub-text {
  display: block;
  font-size: 26rpx;
  color: #c97b88;
  font-weight: 400;
}

/* 进度指示器 */
.progress-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 32rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, #e85365 0%, #ff8fa3 100%);
  border-radius: 50%;
  animation: bounce 1.4s ease-in-out infinite both;
}

.dot-1 { animation-delay: -0.32s; }
.dot-2 { animation-delay: -0.16s; }
.dot-3 { animation-delay: 0s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* ── 装饰分割线 ── */
.divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.divider-line {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(232, 83, 101, 0.3) 50%, transparent 100%);
}

.divider-icon {
  font-size: 28rpx;
  color: #ff8fa3;
  opacity: 0.8;
}

/* ── 返回提示 ── */
.back-hint {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hint-text {
  font-size: 24rpx;
  color: #c97b88;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.hint-arrow {
  font-size: 32rpx;
  color: #e85365;
  animation: bounce-down 1.5s ease-in-out infinite;
  opacity: 0.8;
}

@keyframes bounce-down {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(10rpx); }
}

/* ── 响应式适配 ── */
@media (max-width: 750rpx) {
  .container {
    padding: 30rpx;
  }
  
  .main-title {
    font-size: 44rpx;
  }
  
  .desc-card {
    padding: 36rpx 30rpx;
  }
  
  .icon-container {
    width: 160rpx;
    height: 160rpx;
  }
  
  .gear-large {
    font-size: 100rpx;
  }
  
  .gear-small {
    font-size: 55rpx;
  }
}