/* 樱花飘落容器 */
.sakura-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 9999;
  overflow: hidden;
}

/* 樱花花瓣 */
.sakura {
  position: absolute;
  top: -20rpx;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

/* 花瓣样式 */
.petal {
  width: 20rpx;
  height: 20rpx;
  background: linear-gradient(
    135deg,
    rgba(255, 183, 197, 0.9) 0%,
    rgba(255, 150, 170, 0.8) 50%,
    rgba(255, 182, 193, 0.7) 100%
  );
  border-radius: 150% 0 150% 0;
  box-shadow: 
    0 0 6rpx rgba(255, 182, 193, 0.6),
    inset 0 0 4rpx rgba(255, 255, 255, 0.4);
  animation: petal-rotate 4s ease-in-out infinite;
}

/* 花瓣旋转动画 */
@keyframes petal-rotate {
  0% {
    transform: rotate(0deg) scale(1);
  }
  25% {
    transform: rotate(90deg) scale(0.9);
  }
  50% {
    transform: rotate(180deg) scale(1);
  }
  75% {
    transform: rotate(270deg) scale(0.9);
  }
  100% {
    transform: rotate(360deg) scale(1);
  }
}

/* 飘落动画 - 不同路径 */
@keyframes fall-straight {
  0% {
    transform: translateY(0) translateX(0);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 0.8;
  }
  100% {
    transform: translateY(110vh) translateX(0);
    opacity: 0;
  }
}

@keyframes fall-left {
  0% {
    transform: translateY(0) translateX(0);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  25% {
    transform: translateY(25vh) translateX(-30rpx);
  }
  50% {
    transform: translateY(50vh) translateX(20rpx);
  }
  75% {
    transform: translateY(75vh) translateX(-20rpx);
  }
  90% {
    opacity: 0.8;
  }
  100% {
    transform: translateY(110vh) translateX(10rpx);
    opacity: 0;
  }
}

@keyframes fall-right {
  0% {
    transform: translateY(0) translateX(0);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  25% {
    transform: translateY(25vh) translateX(30rpx);
  }
  50% {
    transform: translateY(50vh) translateX(-20rpx);
  }
  75% {
    transform: translateY(75vh) translateX(20rpx);
  }
  90% {
    opacity: 0.8;
  }
  100% {
    transform: translateY(110vh) translateX(-10rpx);
    opacity: 0;
  }
}

@keyframes fall-wave {
  0% {
    transform: translateY(0) translateX(0);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  20% {
    transform: translateY(20vh) translateX(40rpx);
  }
  40% {
    transform: translateY(40vh) translateX(-40rpx);
  }
  60% {
    transform: translateY(60vh) translateX(40rpx);
  }
  80% {
    transform: translateY(80vh) translateX(-40rpx);
  }
  90% {
    opacity: 0.8;
  }
  100% {
    transform: translateY(110vh) translateX(0);
    opacity: 0;
  }
}
