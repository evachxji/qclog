/* custom-tab-bar/index.wxss */

/* ── 容器 ── */
.tb-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  /* 淘宝白底 + 顶部细线 */
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: stretch;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部渐变阴影 */
.tb-shadow {
  position: absolute;
  top: -20rpx;
  left: 0;
  right: 0;
  height: 20rpx;
  background: linear-gradient(to bottom, rgba(0,0,0,0.06), transparent);
  pointer-events: none;
}

/* ── 单个 Tab 项 ── */
.tb-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: background 0.2s;
}

/* 点击态：轻微缩小 + 背景高亮 */
.tb-item:active {
  background: rgba(230, 81, 0, 0.06);
}

/* 点击态图标动画：缩放弹跳 */
.tb-item.tb-item-active:active .tb-icon {
  transform: scale(1.0);
}

.tb-item:not(.tb-item-active):active .tb-icon {
  transform: scale(0.82);
}

/* ── 图标区域 ── */
.tb-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tb-icon {
  width: 48rpx;
  height: 48rpx;
  /* 默认态：灰色 */
  color: #8d8d8d;
  transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s;
  transform: scale(0.82);
}

/* 选中态：橙色 */
.tb-item-active .tb-icon {
  color: #ff5500;
  transform: scale(1);
}

/* 选中态图标轻微上浮 */
.tb-item-active .tb-icon-wrap {
  transform: translateY(-2rpx);
}

/* ── 文字标签 ── */
.tb-label {
  font-size: 20rpx;
  color: #8d8d8d;
  margin-top: 2rpx;
  transition: color 0.2s, font-weight 0.2s;
  font-weight: 400;
  line-height: 1;
}

/* 选中态：橙色 + 加粗 */
.tb-item-active .tb-label {
  color: #ff5500;
  font-weight: 600;
}

/* ── 底部高亮指示线（淘宝胶囊风格）── */
.tb-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 4rpx;
  background: #ff5500;
  border-radius: 2rpx 2rpx 0 0;
  animation: indicatorIn 0.2s ease-out;
}

@keyframes indicatorIn {
  from {
    width: 0;
    opacity: 0;
  }
  to {
    width: 36rpx;
    opacity: 1;
  }
}

/* ── 点击波纹 ── */
.tb-ripple {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 85, 0, 0.18);
  animation: rippleOut 0.4s ease-out forwards;
  pointer-events: none;
}

@keyframes rippleOut {
  from {
    transform: scale(0.5);
    opacity: 1;
  }
  to {
    transform: scale(1.6);
    opacity: 0;
  }
}
