/* custom-tab-bar/index.wxss */

/* ── 容器 ── */
.tb-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  /* 温暖渐变背景 */
  background: linear-gradient(180deg, #ffffff 0%, #fff5f7 100%);
  border-top: 1rpx solid rgba(255, 143, 163, 0.2);
  display: flex;
  align-items: stretch;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(232, 83, 101, 0.08);
}

/* 顶部渐变阴影 */
.tb-shadow {
  position: absolute;
  top: -20rpx;
  left: 0;
  right: 0;
  height: 20rpx;
  background: linear-gradient(to bottom, rgba(0,0,0,0.06), transparent);
  pointer-events: none;
}

/* ── 单个 Tab 项 ── */
.tb-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: background 0.2s;
}

/* 点击态：轻微缩小 + 背景高亮 */
.tb-item:active {
  background: rgba(232, 83, 101, 0.08);
}

/* 点击态图标动画：缩放弹跳 */
.tb-item.tb-item-active:active .tb-icon {
  transform: scale(1.0);
}

.tb-item:not(.tb-item-active):active .tb-icon {
  transform: scale(0.82);
}

/* ── 图标区域 ── */
.tb-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tb-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
  transform: scale(0.82);
}

/* ── 相册图标：四宫格 ── */
.tb-icon-album .icon-grid {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}

.icon-grid .grid-item {
  width: 18rpx;
  height: 18rpx;
  background: #c97b88;
  border-radius: 4rpx;
  transition: background 0.2s;
}

.tb-item-active .icon-grid .grid-item {
  background: linear-gradient(135deg, #e85365 0%, #ff8fa3 100%);
}

/* ── 开发中图标：三个点 ── */
.tb-icon-dev .icon-tools {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.icon-tools .tool-dot {
  width: 8rpx;
  height: 8rpx;
  background: #c97b88;
  border-radius: 50%;
  transition: background 0.2s;
}

.tb-item-active .icon-tools .tool-dot {
  background: linear-gradient(135deg, #e85365 0%, #ff8fa3 100%);
}

/* 选中态：橙色 */
.tb-item-active .tb-icon {
  color: #ff5500;
  transform: scale(1);
}

/* 选中态图标轻微上浮 */
.tb-item-active .tb-icon-wrap {
  transform: translateY(-2rpx);
}

/* ── 文字标签 ── */
.tb-label {
  font-size: 20rpx;
  color: #c97b88;
  margin-top: 2rpx;
  transition: color 0.2s, font-weight 0.2s;
  font-weight: 400;
  line-height: 1;
}

/* 选中态：粉色 + 加粗 */
.tb-item-active .tb-label {
  color: #e85365;
  font-weight: 600;
}

/* ── 底部高亮指示线（温暖粉色风格）── */
.tb-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #e85365 0%, #ff8fa3 100%);
  border-radius: 2rpx 2rpx 0 0;
  animation: indicatorIn 0.2s ease-out;
}

@keyframes indicatorIn {
  from {
    width: 0;
    opacity: 0;
  }
  to {
    width: 36rpx;
    opacity: 1;
  }
}

/* ── 点击波纹 ── */
.tb-ripple {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(232, 83, 101, 0.18);
  animation: rippleOut 0.4s ease-out forwards;
  pointer-events: none;
}

@keyframes rippleOut {
  from {
    transform: scale(0.5);
    opacity: 1;
  }
  to {
    transform: scale(1.6);
    opacity: 0;
  }
}
