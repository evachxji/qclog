/* pages/index/index.wxss */

.container {
  padding: 20rpx;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background-color: #fff3e0;
}

/* ── 页头 ── */
.header {
  text-align: center;
  padding: 60rpx 30rpx;
  margin-bottom: 40rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.10);
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #e65100;
  margin-bottom: 16rpx;
  text-shadow: 2rpx 2rpx 8rpx rgba(0, 0, 0, 0.10);
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #8d6e63;
}

/* ── 模块列表 ── */
.module-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* ── 模块卡片 ── */
.module-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.3s;
  display: flex;
  align-items: center;
}

.module-card:active {
  transform: scale(0.97);
}

.module-cover {
  width: 200rpx;
  height: 140rpx;
  display: block;
  flex-shrink: 0;
}

.module-info {
  flex: 1;
  padding: 24rpx 30rpx;
}

.module-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #e65100;
  margin-bottom: 8rpx;
}

.module-count {
  display: block;
  font-size: 26rpx;
  color: #8d6e63;
}

/* 响应式布局 */
@media (max-width: 750rpx) {
  .module-cover {
    width: 180rpx;
    height: 120rpx;
  }
  
  .module-info {
    padding: 16rpx 20rpx;
  }
  
  .module-name {
    font-size: 28rpx;
  }
  
  .module-count {
    font-size: 24rpx;
  }
}

@media (max-width: 480rpx) {
  .module-card {
    flex-direction: column;
    align-items: stretch;
  }
  
  .module-cover {
    width: 100%;
    height: 200rpx;
  }
  
  .module-info {
    padding: 16rpx 20rpx;
    text-align: center;
  }
}
