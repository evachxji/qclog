<!-- custom-tab-bar/index.wxml -->
<view class="tb-tabbar">

  <!-- 顶部阴影 -->
  <view class="tb-shadow"></view>

  <!-- Tab 项 -->
  <view
    wx:for="{{tabs}}"
    wx:key="index"
    class="tb-item {{active === index ? 'tb-item-active' : ''}}"
    bindtap="onTabTap"
    data-index="{{index}}"
    data-path="{{item.path}}"
  >
    <!-- 图标 -->
    <view class="tb-icon-wrap">
      <!-- 相册：图片图标 -->
      <view wx:if="{{index === 0}}" class="tb-icon tb-icon-album">
        <view class="icon-grid">
          <view class="grid-item"></view>
          <view class="grid-item"></view>
          <view class="grid-item"></view>
          <view class="grid-item"></view>
        </view>
      </view>
      <!-- 开发中：工具/设置图标 -->
      <view wx:if="{{index === 1}}" class="tb-icon tb-icon-dev">
        <view class="icon-tools">
          <view class="tool-dot"></view>
          <view class="tool-dot"></view>
          <view class="tool-dot"></view>
        </view>
      </view>

      <!-- 点击波纹 -->
      <view class="tb-ripple" wx:if="{{ripple === index}}"></view>
    </view>

    <!-- 文字标签 -->
    <text class="tb-label">{{item.text}}</text>

    <!-- 底部高亮指示线 -->
    <view class="tb-indicator" wx:if="{{active === index}}"></view>
  </view>

</view>
